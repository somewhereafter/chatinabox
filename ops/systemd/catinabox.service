[Unit]
Description=Catinabox owner-only Telegram interface for Codex
After=network-online.target catinabox-bridge.service
Wants=network-online.target
Requires=catinabox-bridge.service

[Service]
Type=simple
User=catinabox
Group=catinabox
WorkingDirectory=/opt/catinabox/current
EnvironmentFile=/etc/catinabox/catinabox.env
ExecStart=/usr/bin/node --experimental-sqlite /opt/catinabox/current/dist/vps/main.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=65s
UMask=0077

[Install]
WantedBy=multi-user.target
