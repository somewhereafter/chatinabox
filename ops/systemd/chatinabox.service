[Unit]
Description=Chatinabox owner-only Telegram interface for Codex
After=network-online.target chatinabox-bridge.service
Wants=network-online.target
Requires=chatinabox-bridge.service

[Service]
Type=simple
User=chatinabox
Group=chatinabox
WorkingDirectory=/opt/chatinabox/current
EnvironmentFile=/etc/chatinabox/chatinabox.env
ExecStart=/usr/bin/node --experimental-sqlite /opt/chatinabox/current/dist/vps/main.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=65s
UMask=0077

[Install]
WantedBy=multi-user.target
