# Required: obtain this from @BotFather.
TG_BOT_TOKEN=123456789:replace-me

# Required: your numeric Telegram user ID. Comma-separated IDs are supported.
TG_ALLOWED_USER_IDS=123456789

# Defaults normally need no changes.
CHATINABOX_DATA_DIR=/var/lib/chatinabox
CHATINABOX_BRIDGE_SOCKET=/run/chatinabox/bridge.sock
CHATINABOX_BRIDGE_DB=/var/lib/chatinabox-bridge/bridge.sqlite
CHATINABOX_ARTIFACT_DB=/var/lib/chatinabox-bridge/artifacts.sqlite
CHATINABOX_DEFAULT_CWD=/root
CHATINABOX_WORKSPACE_ROOTS=/root
CHATINABOX_LOBBY_CWD=/var/lib/chatinabox-bridge/lobby
CHATINABOX_PROFILE_PATH=/etc/chatinabox/profile.json

# Optional profile mappings. These defaults match the original deployment.
CHATINABOX_SOL_MODEL=gpt-5.6-sol
CHATINABOX_TERRA_MODEL=gpt-5.6-terra
CHATINABOX_LUNA_MODEL=gpt-5.6-luna

# Optional executable overrides, useful on nonstandard hosts.
# CHATINABOX_CODEX_PATH=/usr/local/bin/codex
# CHATINABOX_TMUX_PATH=/usr/bin/tmux
# CHATINABOX_CONVERT_PATH=/usr/bin/convert
# CHATINABOX_CHROME_PATH=/usr/bin/google-chrome

# Optional session artifact shelf. Native Telegram sharing works without it.
# Point these at any server that implements docs/ARTIFACT-PUBLISHER.md.
# CHATINABOX_ARTIFACTS_API_URL=https://artifacts.example.com/api/
# CHATINABOX_ARTIFACTS_API_TOKEN=replace-with-a-long-random-secret
