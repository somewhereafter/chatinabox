# Required: obtain this from @BotFather.
TG_BOT_TOKEN=123456789:replace-me

# Required: your numeric Telegram user ID. Comma-separated IDs are supported.
TG_ALLOWED_USER_IDS=123456789

# Defaults normally need no changes.
CATINABOX_DATA_DIR=/var/lib/catinabox
CATINABOX_BRIDGE_SOCKET=/run/catinabox/bridge.sock
CATINABOX_BRIDGE_DB=/var/lib/catinabox-bridge/bridge.sqlite
CATINABOX_DEFAULT_CWD=/root
CATINABOX_LOBBY_CWD=/var/lib/catinabox-bridge/lobby

# Optional profile mappings. These defaults match the original deployment.
CATINABOX_SOL_MODEL=gpt-5.6-sol
CATINABOX_TERRA_MODEL=gpt-5.6-terra
CATINABOX_LUNA_MODEL=gpt-5.6-luna

# Optional executable overrides, useful on nonstandard hosts.
# CATINABOX_CODEX_PATH=/usr/local/bin/codex
# CATINABOX_TMUX_PATH=/usr/bin/tmux
# CATINABOX_CONVERT_PATH=/usr/bin/convert
# CATINABOX_CHROME_PATH=/usr/bin/google-chrome
