{
  "name": "chatinabox",
  "version": "2.4.6",
  "description": "Real Codex CLI sessions in a private Telegram chat or forum",
  "license": "MIT",
  "author": "somewhereafter",
  "repository": {
    "type": "git",
    "url": "https://github.com/somewhereafter/chatinabox.git"
  },
  "homepage": "https://github.com/somewhereafter/chatinabox#readme",
  "bugs": {
    "url": "https://github.com/somewhereafter/chatinabox/issues"
  },
  "keywords": [
    "codex",
    "telegram",
    "tmux",
    "remote-terminal",
    "telegram-forum",
    "agent"
  ],
  "bin": {
    "chatinabox": "./bin/chatinabox"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/vps/main.js",
    "bridge": "node --experimental-sqlite dist/vps/codex-bridge-main.js",
    "test": "vitest run --config test-vps/vitest.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test-vps/tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "markdown-it": "^14.3.0",
    "rebrowser-puppeteer-core": "^23.10.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
